    "TASK_QUEUED",
    "TASK_CLAIMED",
    "AGENT_ACTIVATED",
    "SKILL_SELECTED",
    "TOOL_CALLED",
    "EVIDENCE_RECORDED",
    "CHECKPOINT_SAVED",
    "GATE_PASSED",
    "GATE_FAILED",
    "INCIDENT_OPENED",
    "REPAIR_STARTED",
    "REPAIR_COMPLETED",
    "LESSON_CANDIDATE_CREATED",
    "REGRESSION_EVAL_CREATED",
    "CANDIDATE_PROMOTED",
    "CANDIDATE_REJECTED",
    "RUN_BLOCKED",
    "RUN_FAILED",
    "RUN_COMPLETED",
    "WATCHDOG_RECOVERY"
