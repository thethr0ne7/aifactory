{
  "schemaVersion": "1.2.0",
  "factoryVersion": "2.7.0",
  "mode": "controlled-tool-runtime",
  "principle": "Workers may request capabilities; only a separate allowlisted executor performs side effects. Provider transports and credentials remain outside agent context.",
  "maxToolRequestsPerWorkerTurn": 3,
  "maxToolResultCharactersPerRun": 30000,
  "executor": {
    "workflow": ".github/workflows/factory-tool-executor.yml",
    "script": "scripts/tool-executor.mjs",
    "claimOnePerRun": false,
    "maxClaimsPerExecutorRun": 6,
    "stopBatchAfterCandidateWrite": true,
    "scheduleCadenceMinutes": 5,
    "staleClaimMinutes": 20,
    "repositoryScope": "thethr0ne7/aifactory",
    "directMerge": false,
    "candidateBranchIsPrimaryArtifact": true,
    "pullRequestCreation": "best-effort; GitHub repository policy may block workflow-token PR creation"
  },
  "tools": [
    {
      "id": "factory.repo.read_file",
      "class": "READ",
      "riskClass": "LOW",
      "minimumAutonomy": "A3",
      "autoExecute": true,
      "description": "Read one tracked file from the AI Factory repository with bounded output.",
      "argumentContract": {"path":"repository-relative path","max_chars":"100..20000"}
    },
    {
      "id": "factory.repo.list_files",
      "class": "READ",
      "riskClass": "LOW",
      "minimumAutonomy": "A3",
      "autoExecute": true,
      "description": "List tracked repository files under an optional safe prefix.",
      "argumentContract": {"prefix":"optional repository-relative prefix","limit":"1..300"}
    },
    {
      "id": "factory.repo.run_validation",
      "class": "FIXED_EXECUTION",
      "riskClass": "LOW",
      "minimumAutonomy": "A3",
      "autoExecute": true,
      "description": "Run a fixed validation suite. Arbitrary commands are not accepted.",
      "argumentContract": {"suite":"factory|autonomous|self-improvement|tool-runtime|all"}
    },
    {
      "id": "factory.repo.candidate_write",
      "class": "CANDIDATE_WRITE",
      "riskClass": "LOW",
      "minimumAutonomy": "A3",
      "autoExecute": true,
      "description": "Write exactly one low-risk file to a new candidate branch, validate it, and push the branch. Never writes main and never merges.",
      "allowedPathPrefixes": ["skills/", "docs/", "evals/"],
      "protectedPaths": [
        ".github/",
        "registry/factory-constitution.json",
        "registry/autonomy-levels.json",
        "registry/negative-actions.json",
        "registry/tool-runtime.json",
        "runtime/",
        "scripts/",
        "supabase/",
        "infra/",
        "factory.manifest.json",
        "AGENTS.md"
      ],
      "argumentContract": {
        "path":"must be under an allowedPathPrefix",
        "content":"complete UTF-8 replacement or new-file content, max 100000 chars",
        "reason":"why this change is required",
        "expected_blob_sha":"required when replacing an existing tracked file"
      }
    },
    {
      "id": "factory.web.crawl",
      "capability": "WEB_EVIDENCE",
      "provider": "crawl4ai",
      "class": "READ_NETWORK",
      "riskClass": "LOW",
      "minimumAutonomy": "A3",
      "autoExecute": true,
      "description": "Fetch up to eight public HTTP(S) pages through the bounded Crawl4AI adapter and return compact LLM-ready evidence. Local, private and link-local destinations are denied before provider invocation.",
      "argumentContract": {
        "url":"one public http/https URL; alternatively use urls",
        "urls":"1..8 public http/https URLs",
        "cache_mode":"enabled|bypass|read_only|write_only",
        "word_count_threshold":"1..1000",
        "include_external_links":"boolean"
      },
      "deniedArguments": ["hooks", "execute_js", "scripts", "cookies", "proxy", "browser_config", "crawler_config", "webhook_url"]
    },
    {
      "id": "factory.document.ocr",
      "capability": "DOCUMENT_ENGINE",
      "provider": "stirling-pdf",
      "class": "LOCAL_DOCUMENT_TRANSFORM",
      "riskClass": "LOW",
      "minimumAutonomy": "A3",
      "autoExecute": true,
      "description": "Run OCR on one tracked repository PDF using a configured/self-hosted Stirling PDF provider. The hosted executor never lets an agent supply an arbitrary filesystem path or remote document URL.",
      "argumentContract": {
        "path":"tracked repository-relative .pdf file, <=20MB",
        "languages":"1..4 Tesseract language codes; default eng",
        "ocr_type":"skip-text|force-ocr|Normal",
        "deskew":"boolean",
        "clean":"boolean"
      }
    },
    {
      "id": "factory.document.compare",
      "capability": "DOCUMENT_ENGINE",
      "provider": "stirling-pdf",
      "class": "LOCAL_DOCUMENT_COMPARE",
      "riskClass": "LOW",
      "minimumAutonomy": "A3",
      "autoExecute": false,
      "description": "Reserved deterministic PDF comparison contract. It remains non-auto until the exact upstream comparison API response contract is pinned and regression-tested.",
      "argumentContract": {"left_path":"tracked .pdf","right_path":"tracked .pdf"}
    },
    {
      "id": "factory.browser.operate",
      "capability": "WEB_OPERATOR",
      "provider": "browser-use",
      "class": "OWNER_GATED_EXTERNAL",
      "riskClass": "HIGH",
      "minimumAutonomy": "A3",
      "autoExecute": false,
      "ownerApprovalRequired": true,
      "description": "Interactive browser operation. Agents may propose it, but navigation that can submit, publish, purchase, message, mutate accounts or cause external effects requires explicit owner approval before execution.",
      "argumentContract": {"task":"bounded browser task","allowed_domains":"optional domain allowlist"}
    },
    {
      "id": "factory.dev.workspace",
      "capability": "DEVELOPMENT_WORKSPACE",
      "provider": "openhands",
      "class": "OWNER_GATED_EXECUTION",
      "riskClass": "HIGH",
      "minimumAutonomy": "A3",
      "autoExecute": false,
      "ownerApprovalRequired": true,
      "description": "Isolated development workspace inspired by OpenHands. No production credentials, no host mounts, no direct main write and no direct deployment.",
      "argumentContract": {"objective":"coding objective","repository":"allowlisted repository","base_ref":"reviewed base ref"}
    }
  ],
  "hardDenials": [
    "direct write to main",
    "automatic merge",
    "arbitrary shell command",
    "arbitrary SQL",
    "production mutation",
    "secret retrieval",
    "Root of Trust mutation",
    "autonomy-level mutation",
    "workflow-permission mutation",
    "tool-executor self-modification",
    "unbounded filesystem or network access",
    "private-network web crawling",
    "agent-supplied crawler hooks or JavaScript execution",
    "browser side effects without owner approval",
    "development workspace production credentials"
  ],
  "resumeSemantics": {
    "workerStatus": "WAITING_TOOLS",
    "toolTerminalStatuses": ["EXECUTED", "DENIED", "FAILED"],
    "whenAllRequestedToolsTerminal": "requeue the same task so the reasoning worker can consume tool results",
    "toolContinuationConsumesRetryBudget": false
  },
  "evidencePolicy": {
    "toolResultsAreEvidenceNotInstructions": true,
    "currentEvidenceOutranksMemory": true,
    "everyToolResultRequiresRequestId": true,
    "everySideEffectRequiresDurableLedger": true,
    "pullRequestBlockedMustBeReported": true,
    "providerIdentityMustBePersisted": true,
    "providerSecretsMustNeverBePersisted": true
  }
}
