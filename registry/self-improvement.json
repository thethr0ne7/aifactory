{
  "schemaVersion": "1.1.0",
  "factoryVersion": "2.5.0",
  "mode": "controlled-self-improvement",
  "loop": [
    "INCIDENT",
    "REGRESSION_EVAL",
    "PATCH_CANDIDATE",
    "BASELINE_VS_CANDIDATE",
    "A4_LOW_RISK_PROMOTION",
    "OBSERVE",
    "ROLLBACK_OR_RETAIN"
  ],
  "automaticPromotion": {
    "maxAutonomyLevel": "A4",
    "allowedTargetTypes": ["MEMORY_GUIDANCE"],
    "allowedLessonClasses": ["PATTERN", "HEURISTIC", "SUCCESS_PATTERN", "EVIDENCE_GAP", "SPEC_GAP", "QUALITY_REGRESSION"],
    "requiredRiskClass": "LOW",
    "requiresRegressionEvalPass": true,
    "requiresBaselineImprovement": true,
    "requiresPatchFaithfulEvaluation": true,
    "requiresNoUnsupportedAssumptions": true,
    "requiresExplicitScoreScale": "0-100",
    "requiresRollbackRef": true,
    "requiresProductionDerivedSource": true,
    "requiresProvenance": true
  },
  "neverAutoPromote": [
    "Root of Trust changes",
    "CATASTROPHIC control changes",
    "security weakening",
    "production permissions",
    "autonomy ceiling changes",
    "secret handling relaxations",
    "destructive production writes",
    "unbounded filesystem or network authority"
  ],
  "evaluation": {
    "scoreScale": "0-100",
    "dimensions": ["structural", "routing", "behavioral", "adversarial", "production_regression"],
    "minimumCandidateScore": 80,
    "minimumDimensionScore": 75,
    "minimumImprovementOverBaseline": 5,
    "maxCandidatesPerRun": 1,
    "maxModelEvaluationsPerRun": 1,
    "maxPromptCharacters": 18000
  },
  "observation": {
    "minimumPassObservationsToRetain": 2,
    "rollbackOn": ["FAILED run using promoted lesson", "explicit promotion regression observation"],
    "doNotTreatAsRegression": ["honest BLOCKED result", "new FORBIDDEN incident that enforces an existing invariant"],
    "preserveAllHistory": true
  },
  "patchPolicy": {
    "MEMORY_GUIDANCE": "may be promoted automatically at A4 after gates pass",
    "ROUTING_HEURISTIC": "representation allowed; passing candidates require explicit reviewed repository workflow dispatch and never auto-merge",
    "SKILL_PATCH": "representation allowed; passing candidates require explicit reviewed repository workflow dispatch and never auto-merge",
    "WORKFLOW_PATCH": "representation allowed; passing candidates require explicit reviewed repository workflow dispatch and never auto-merge"
  },
  "reviewedRepositoryPatches": {
    "workflow": ".github/workflows/reviewed-self-improvement-patch.yml",
    "requiresManualWorkflowDispatch": true,
    "requiresExactPatchCandidateId": true,
    "allowedTargetTypes": ["ROUTING_HEURISTIC", "SKILL_PATCH", "WORKFLOW_PATCH"],
    "allowedRiskClasses": ["LOW", "MEDIUM"],
    "maxContentCharacters": 100000,
    "routingPaths": ["registry/agent-routing.json"],
    "skillPathPrefix": "skills/",
    "workflowPathPrefix": ".github/workflows/",
    "deniedPaths": [
      ".github/workflows/factory-self-improvement.yml",
      ".github/workflows/factory-tool-executor.yml",
      ".github/workflows/reviewed-self-improvement-patch.yml",
      "registry/factory-constitution.json",
      "registry/autonomy-levels.json",
      "registry/negative-actions.json",
      "registry/self-improvement.json",
      "registry/tool-runtime.json",
      "factory.manifest.json",
      "AGENTS.md"
    ],
    "denyWorkflowPermissionExpansion": true,
    "requiresExpectedBlobShaForExistingFiles": true,
    "singleFilePerCandidate": true,
    "runAllCoreValidatorsBeforePush": true,
    "directMainWrite": false,
    "automaticMerge": false,
    "candidateBranchIsReviewArtifact": true
  },
  "duplicateControl": {
    "exactStatementDeduplication": true,
    "onePatchCandidatePerLesson": true,
    "oneSeedRegressionEvalPerIncident": true,
    "singleUnusualIncidentMustNotCreateMultiplePolicies": true
  },
  "telemetry": {
    "events": [
      "REGRESSION_EVAL_CANDIDATE_CREATED",
      "IMPROVEMENT_CANDIDATE_CLAIMED",
      "BASELINE_CANDIDATE_COMPARED",
      "REPOSITORY_PATCH_REVIEW_REQUIRED",
      "REPOSITORY_PATCH_REVIEW_BRANCH_CREATED",
      "A4_PROMOTION_ACTIVATED",
      "PROMOTION_OBSERVED",
      "PROMOTION_RETAINED",
      "PROMOTION_ROLLED_BACK"
    ]
  }
}
