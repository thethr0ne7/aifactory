{
  "factory": "AI Factory",
  "version": "2.2.0",
  "architecturePolicy": "AI Factory 2.x core plus bounded amplifiers; no platform rewrite",
  "defaultMode": "selective-routing",
  "contextPolicy": "budgeted",
  "truthPolicy": "evidence-first",
  "shipPolicy": "gated",
  "multiAgentDefault": "off",
  "thirdPartyDefault": "pattern-only-until-audited",
  "executionLoops": {
    "core": ["INPUT", "PLAN", "PRODUCE", "CHECK", "FIX", "SAVE", "SHIP"],
    "researchGrade": ["INPUT", "QUALIFY", "SPEC_LOCK", "STRATEGY_SEARCH", "CANDIDATE_GENERATION", "EVIDENCE_CHECK", "CONTRADICTION_SCAN", "RISK_MAP", "DRAFT", "REVIEW", "SHIP", "TRACEBACK"]
  },
  "coreContours": [
    "repo-intake-runability",
    "evidence-locked-extraction",
    "evaluation-quality-gates",
    "agent-workflow-stateful-control",
    "repair-self-healing",
    "factory-memory-knowledge-graph",
    "defensive-security-pre-ship"
  ],
  "secondRingAmplifiers": ["ui-taste-gate", "compound-skill-loop", "recent-signal-radar", "context-governor", "https-autopilot"],
  "capabilityFamilies": [
    "executive-and-context",
    "research-and-truth",
    "engineering",
    "design-and-media",
    "marketing-and-growth",
    "knowledge-and-data",
    "security-and-quality"
  ],
  "registry": "registry/capabilities.json",
  "roleRegistry": "registry/roles.json",
  "executiveAgentRegistry": "registry/executive-agents.json",
  "executiveRuntime": "runtime/executive-team.json",
  "executiveProfiles": "agents/executive/",
  "globalAgentContract": "AGENTS.md",
  "architecture": "docs/ARCHITECTURE.md"
}
